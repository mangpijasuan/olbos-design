# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002

# ── Database (Postgres, via docker-compose) ────────────────────────────────
DATABASE_URL="postgresql://olbos:olbos_dev_password@localhost:5433/olbosevents?schema=public"

# ── Redis (via docker-compose) ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth (Better Auth) ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In is disabled until these are supplied (requires a paid Apple
# Developer account, Services ID, and a private key) — see README "Auth" section.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Object storage (S3-compatible; MinIO locally via docker-compose) ───────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=olbosevents-media
S3_ACCESS_KEY_ID=olbos_minio
S3_SECRET_ACCESS_KEY=olbos_minio_password
S3_FORCE_PATH_STYLE=true
# Public base URL guests' browsers use to load uploaded media.
S3_PUBLIC_URL=http://localhost:9000/olbosevents-media

# ── Stripe ───────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_ESSENTIAL=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_PRICE_ID_LUXE=

# ── PayPal (deferred to a later phase — see roadmap in README) ─────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="OLBOS DESIGN <invitations@olbosevent.com>"
CONTACT_INBOX_EMAIL=

# ── SMS (Twilio — deferred to a later phase) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Maps ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── QR / check-in ────────────────────────────────────────────────────────
# HMAC secret used to sign per-guest QR check-in tokens. Generate with:
# openssl rand -hex 32
QR_SIGNING_SECRET=
